  "workbench.sash.size": 2,
  "semanticHighlighting": true,
  "semanticTokenColors": {
    // "*.abstract": "#ff0000",
    // "*.async": "#ff0000",
    "*.declaration": "#D4BFFF",
    "class": {
      "foreground": "#F29E74",
      "fontStyle": ""
    },
    "class.declaration": "#5CCFE6",
    "class.defaultLibrary": "#5CCFE6",
    "comment": {
      "foreground": "#5C6773",
      "fontStyle": "italic"
    },
    "event": {},
    "string": {
      "foreground": "#BAE67E",
      "fontStyle": ""
    },
    // "string.template": { "foreground": "#ff0000", "fontStyle": "" },
    // "keyword": "#ff0000",
    "customLiteral": "#DCDCAA",
    "function.declaration": "#FFD580",
    "function": {
      "foreground": "#ffd580",
      "fontStyle": ""
    },
    "keyword.operator.new": "#FFD580",
    "method.declaration.async": "#FFD580",
    "method.defaultLibrary": "#F27983",
    "method": "#FFD580",
    "number": {
      "foreground": "#8C9EFF",
      "fontStyle": ""
    },
    "newOperator": "#C586C0",
    "numberLiteral": "#b5cea8",
    // "property.declaration": "#BAE67E",
    "readonly.local": "#BAE67E",
    "stringLiteral": "#ce9178",
    "support.defaultLibrary": "#F27983",
    "type": {
      "foreground": "#B9F6CA",
      "fontStyle": ""
    },
    "interface": {
      "foreground": "#B9F6CA",
      "fontStyle": ""
    },
    // "interface": { "foreground": "#BEE2E1DD", "fontStyle": "" },
    "property": {
      "foreground": "#CBCCC6",
      "fontStyle": ""
    },
    "property.declaration": {
      "foreground": "#BAE67E",
      "fontStyle": ""
    },
    "parameter": {
      "foreground": "#CBCCC6",
      "fontStyle": ""
    },
    "parameter.declaration": {
      "foreground": "#D4BFFF",
      "fontStyle": ""
    },
    // "typeParameter": "#ff0000",
    "module": {
      "foreground": "#F29E74",
      "fontStyle": ""
    },
    "variable": "#CBCCC6",
    "variable.defaultLibrary": "#59C9DE99",
    "variable.local": "#CBCCC6",
    "variable.language.this": {
      "foreground": "#5CCFE6",
      "fontStyle": "italic"
    }
  },
  "tokenColors": [
    {
      "name": "vue-punctuation-begin",
      "scope": [
        "punctuation.definition.tag.begin.html.vue",
        "source.vue"
      ],
      "settings": {
        "foreground": "#73d0ff",
        "fontStyle": ""
      }
    },
    {
      "name": "vue-punctuation-end",
      "scope": [
        "punctuation.definition.tag.end.html.vue",
        "source.vue"
      ],
      "settings": {
        "foreground": "#73d0ff",
        "fontStyle": ""
      }
    },
    {
      "name": "vue-template",
      "scope": [
        "entity.name.tag.template.html.vue",
        "source.vue"
      ],
      "settings": {
        "foreground": "#73d0ff",
        "fontStyle": ""
      }
    },
    {
      "name": "vue-div",
      "scope": [
        "entity.name.tag.html",
        "meta.tag.structure.div.start.html",
        "text.html.derivative",
        "source.vue"
      ],
      "settings": {
        "foreground": "#ffd580",
        "fontStyle": ""
      }
    },
    {
      "name": "vue-attr",
      "scope": [
        "punctuation.attribute-shorthand.bind.html.vue",
        "meta.attribute.directive.vue",
        "meta.tag.structure.div.start.html",
        "text.html.derivative",
        "source.vue",
      ],
      "settings": {
        "foreground": "#f1f1f1",
        "fontStyle": ""
      }
    }
  ]
}
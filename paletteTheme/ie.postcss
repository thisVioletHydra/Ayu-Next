
.formCaptcha__style .formCaptcha__box {
  display: grid;
  grid-gap: 8px;
}
.formCaptcha__style .formCaptcha__container {
  display: grid;
  grid: auto / 1fr minmax(auto, 48px);
  grid-gap: 8px;
  align-items: stretch;
  justify-content: stretch;
}
.formCaptcha__style .formCaptcha__label {
  display: grid;
  grid-gap: 8px;
  margin: unset;
  grid: minmax(auto, 48px) / 1fr minmax(auto, 160px);
}
  
.formCaptcha__style .formCaptcha__title {
  font-weight: 600;
  font-size: 16px;
  color: var(--color-gray-90, initial);
  font-family: var(--font-main, sans-serif);
}
.formCaptcha__style .formCaptcha__button--reset {
    display: grid;
  align-items: center;
  justify-content: center;
  color: var(--color-blue-60, #04c);
  background-color: #0000;
  border: 0;
  border-radius: 4px;
  line-height: normal;
  padding: 11px;
  user-select: none;
  text-decoration: none;
  font-size: 16px;
  text-transform: unset;
  overflow: hidden;
  cursor: pointer;
  transition:   background-color 0.123s;
}
.formCaptcha__container .formCaptcha__button--reset:hover {
  background-color: var(--color-cursor-hover, #f3f5f7);
}
.formCaptcha__container .formCaptcha__button--reset:active {
  background-color: var(--color-cursor-hover, #e1e1e1);
}

.formCaptcha__style input:not([type='checkbox'], [type='radio']) {
  background-color: var(--color-null, initial);
  border-radius: 4px;
  border: 1px solid;
  border-color: var(--color-gray-30, #c4c8d0);
  color: var(--color-gray-90, initial);
  display: grid;
  font-family: var(--font-main, sans-serif);
  font-size: 16px;
  font-weight: 400;
  line-height: 24px;
  height: unset;
  max-height: 48px;
  padding: 12px 16px;
  width: unset;
  transition: unset;
}
.formCaptcha__style .formCaptcha__container input.captcha-input-field[name='captcha_answer'] {
  border: 1px solid;
  border-radius: 4px;
  border-color: var(--color-gray-30, #c4c8d0);
}
.formCaptcha__style .formCaptcha__container input.captcha-input-field[name='captcha_answer']:focus {
  border: 1px solid;
  border-radius: 4px;
  border-color: #0000;
  outline: 4px solid;
  outline-offset: 0;
  outline-color: #5faee3;
}
.formCaptcha__style .formCaptcha__icon {
    display: grid;
  align-items: stretch;
  justify-content: stretch;
  background-color: #0000;
  border: 0;
  border-radius: 100%;
   width: 24px;
  height: 24px;
}
.formCaptcha__style .formCaptcha__icon img {
    object-fit: cover;
  max-height: 100%;
  max-width: 100%;
  width: 100%;
  height: auto;
  user-drag: none;
  -webkit-user-drag: none;
  user-select: none;
  user-select: none;
  user-select: none;
   pointer-events: none;
  user-select: none;
}
 


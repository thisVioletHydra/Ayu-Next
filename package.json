{
  "icon": "images/icon-hero.png",
  "name": "ayu-next",
  "displayName": "Ayu Next",
  "description": "\ud83d\udd25 This is a Dark theme (Mirage), screenshots inside",
  "version": "2.0.5",
  "license": "MIT",
  "private": false,
  "type": "module",
  "imports": {
    "#colors": "./src/colors.ts",
    "#semanticTokenColors": "./src/semanticTokenColors.ts",
    "#tokenColors": "./src/tokenColors.ts",
    "#types/*": "./src/types/*.d.ts",
    "#tokens": "./src/tokens/index.ts",
    "#tokens/catalog": "./src/tokens/catalog/index.ts",
    "#tokens/catalog/*": "./src/tokens/catalog/*.ts",
    "#tokens/*": "./src/tokens/*.ts",
    "#paint": "./src/paint/index.ts",
    "#paint/*": "./src/paint/*.ts",
    "#syntax/*": "./src/syntax/*.ts",
    "#ts/tsTypes": "./src/ts/tsTypes/index.ts",
    "#ts/tsTypes/*": "./src/ts/tsTypes/*.ts",
    "#ts/tsClasses": "./src/ts/tsClasses/index.ts",
    "#ts/tsClasses/*": "./src/ts/tsClasses/*.ts",
    "#ts/tsLanguage": "./src/ts/tsLanguage/index.ts",
    "#ts/tsLanguage/*": "./src/ts/tsLanguage/*.ts",
    "#ts/tsKeywords": "./src/ts/tsKeywords/index.ts",
    "#ts/tsKeywords/*": "./src/ts/tsKeywords/*.ts",
    "#ts/tsDecorators": "./src/ts/tsDecorators/index.ts",
    "#ts/tsDecorators/*": "./src/ts/tsDecorators/*.ts",
    "#ts/tsProps": "./src/ts/tsProps/index.ts",
    "#ts/tsProps/*": "./src/ts/tsProps/*.ts",
    "#data/*": "./src/data/*",
    "#tokenLayers": "./src/tokenLayers.ts"
  },
  "publisher": "Roman",
  "author": "VioletHydra <thisviolethydra@gmail.com>",
  "homepage": "https://github.com/thisVioletHydra/ayu-next#readme",
  "bugs": {
    "url": "https://github.com/thisVioletHydra/ayu-next/issues",
    "email": "thisviolethydra@gmail.com"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com/"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/thisVioletHydra/ayu-next.git"
  },
  "engines": {
    "vscode": "^1.22.0",
    "node": ">=24",
    "pnpm": ">=12.4.1"
  },
  "packageManager": "pnpm@12.4.1",
  "categories": [
    "Themes"
  ],
  "keywords": [
    "theme",
    "ayu",
    "dark",
    "color-theme",
    "icon-theme"
  ],
  "contributes": {
    "configurationDefaults": {
      "editor.semanticHighlighting.enabled": true
    },
    "themes": [
      {
        "label": "Ayu Next",
        "uiTheme": "vs-dark",
        "path": "./themes/ayu-next-color-theme.json"
      }
    ]
  },
  "scripts": {
    "gen:keys": "tsx scripts/gen-workbench-keys.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "build": "tsx src/build.ts",
    "build:watch": "tsx --watch src/build.ts",
    "theme:debug": "pnpm build && tsx scripts/debug-theme-colors.ts",
    "lint": "oxlint .",
    "lint:fix": "oxlint --fix .",
    "package": "pnpm build && vsce package",
    "publish": "pnpm build && vsce publish"
  },
  "devDependencies": {
    "@oxyhub/oxlint-plugin": "^0.3.1",
    "@types/node": "^26.5.1",
    "@vscode/vsce": "^3.9.2",
    "oxlint": "^1.82.0",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2"
  }
}
